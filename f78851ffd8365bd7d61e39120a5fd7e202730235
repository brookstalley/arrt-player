{"schema": 1, "kind": "review", "id": "rev-20261113T204743Z-fdd90287", "ts": "2026-11-13T20:53:45Z", "actor": {"worktree": "arrt-player", "plugin": "3.8.2-dev.1", "branch": "feature/slideshow", "build": "1151816623d4"}, "body": {"base_commit": "3ee81a6ec68ad630e9117fbeb9bdb56035a3d26e", "base_tree": "8d4f79ac878387c2454b06727e89f96f8ff2894f", "head_tree": "5f30a004a5f678d71c242dfd8b2292bc70f87786", "head_commit": "f78851ffd8365bd7d61e39120a5fd7e202730235", "dispatch_commit": "f78851ffd8365bd7d61e39120a5fd7e202730235", "mode": "cumulative (bundle review, ready for merge)", "mode_chosen_by": "explicit-args", "stage": "boundary", "tier": "standard", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": [".env.example", ".gitignore", "deploy/README.md", "deploy/display.service", "pyproject.toml", "src/arrt_player/__main__.py", "src/arrt_player/config.py", "src/arrt_player/dwell.py", "src/arrt_player/kms.py", "src/arrt_player/label_renderer.py", "src/arrt_player/mpv.py", "src/arrt_player/programmes/slideshow.py", "src/arrt_player/programmes/slideshow_status.py", "src/arrt_player/pull.py", "src/arrt_player/settings_ui/server.py", "src/arrt_player/settings_ui/static/settings.css", "src/arrt_player/settings_ui/store.py", "src/arrt_player/sources/__init__.py", "src/arrt_player/sources/cache.py", "src/arrt_player/sources/fetch.py", "src/arrt_player/sources/reddit.py", "src/arrt_player/sources/reddit_settings.py", "src/arrt_player/sources/resolvers/__init__.py", "src/arrt_player/sources/resolvers/imgur.py", "src/arrt_player/sources/resolvers/redgifs.py", "tests/conftest.py", "tests/fake_mpv.py", "tests/fixtures/reddit/README.md", "tests/fixtures/reddit/shapes.json", "tests/fixtures/redgifs/README.md", "tests/fixtures/redgifs/auth.json", "tests/fixtures/redgifs/gif.json", "tests/fixtures/redgifs/gif_missing.json", "tests/fixtures/redgifs/unauthorized.json", "tests/test_config.py", "tests/test_deploy_unit.py", "tests/test_dwell.py", "tests/test_fetch.py", "tests/test_logs.py", "tests/test_media_cache.py", "tests/test_mpv.py", "tests/test_plane_isolation.py", "tests/test_reddit_settings.py", "tests/test_reddit_source.py", "tests/test_resolvers.py", "tests/test_settings_ui.py", "tests/test_slideshow.py", "tests/test_tools.py", "tools/mpv_check.py", "uv.lock"], "files_changed": [".env.example", ".gitignore", ".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-slideshow.md", ".prawduct/artifacts/hdmi-output-findings.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/observability-strategy.md", ".prawduct/artifacts/platform-and-dependency-findings.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/slideshow.md", ".prawduct/project-state.yaml", ".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md", "deploy/README.md", "deploy/display.service", "pyproject.toml", "src/arrt_player/__main__.py", "src/arrt_player/config.py", "src/arrt_player/dwell.py", "src/arrt_player/kms.py", "src/arrt_player/label_renderer.py", "src/arrt_player/mpv.py", "src/arrt_player/programmes/slideshow.py", "src/arrt_player/programmes/slideshow_status.py", "src/arrt_player/pull.py", "src/arrt_player/settings_ui/server.py", "src/arrt_player/settings_ui/static/settings.css", "src/arrt_player/settings_ui/store.py", "src/arrt_player/sources/__init__.py", "src/arrt_player/sources/cache.py", "src/arrt_player/sources/fetch.py", "src/arrt_player/sources/reddit.py", "src/arrt_player/sources/reddit_settings.py", "src/arrt_player/sources/resolvers/__init__.py", "src/arrt_player/sources/resolvers/imgur.py", "src/arrt_player/sources/resolvers/redgifs.py", "tests/conftest.py", "tests/fake_mpv.py", "tests/fixtures/reddit/README.md", "tests/fixtures/reddit/shapes.json", "tests/fixtures/redgifs/README.md", "tests/fixtures/redgifs/auth.json", "tests/fixtures/redgifs/gif.json", "tests/fixtures/redgifs/gif_missing.json", "tests/fixtures/redgifs/unauthorized.json", "tests/test_config.py", "tests/test_deploy_unit.py", "tests/test_dwell.py", "tests/test_fetch.py", "tests/test_logs.py", "tests/test_media_cache.py", "tests/test_mpv.py", "tests/test_plane_isolation.py", "tests/test_reddit_settings.py", "tests/test_reddit_source.py", "tests/test_resolvers.py", "tests/test_settings_ui.py", "tests/test_slideshow.py", "tests/test_tools.py", "tools/mpv_check.py", "uv.lock"], "files_oracle": [".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-slideshow.md", ".prawduct/artifacts/hdmi-output-findings.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/observability-strategy.md", ".prawduct/artifacts/platform-and-dependency-findings.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/slideshow.md", ".prawduct/project-state.yaml", ".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "Test evidence is stale: nothing records a run of the merged tree or of f78851f's new brightness tests", "recommendation": "`prawduct-hook test-status` exits 1: \"stale: evidence predates session (2026-11-13T18:35:06Z < 2026-11-13T20:40:31Z)\". `.test-evidence.json` is from evidence tree cd4db43, which is the hdmi-brightness work. It predates the develop merge (019e13b) and the head commit. That commit adds five brightness tests to tests/test_slideshow.py and three slideshow-location tests to tests/test_config.py, and none of them has a recorded run. A merge-boundary review therefore has no evidence that the merged suite passes. Run the recorded suite (`testament run --json`, else `uv run --group raster pytest`) on this tree before the PR. Instance: the evidence is one run behind the tree.", "files": ["tests/test_slideshow.py", "tests/test_config.py", "src/arrt_player/programmes/slideshow.py", "src/arrt_player/__main__.py"], "fid": "R-1"}, {"goal": "Nothing Is Missing", "severity": "warning", "title": "Chunk 05's acceptance on the Pi is neither met nor descoped, and the bundle is under its merge-boundary review", "recommendation": "The plan's chunk 05 is `Type: cumulative-final`. Its Done-when puts 'Acceptance criteria met' before the cumulative review. Its criteria are: switch to slideshow from the page on the Pi; the owner's listing plays on the LG at 4K with captions on the panel; switch back and the wall returns; and check the cookie's renewal (`exp` on the Pi's copy). Its description also requires 'The deploy on the Pi, by the runbook, with the owner watching', and chunk 03's open item said chunk 05 'plays one [redgifs HD clip taller than 1080] on the Pi and decides' whether RedgifsResolver should prefer `sd`. hdmi-output-findings.md \u00a7 Not observed still lists both the whole slideshow on the Pi and the >1080 redgifs clip as 'Owed by the slideshow plan's acceptance'. The session handoff says the branch 'is not ready for a PR. Chunk 05 is open and needs Pi acceptance'. So this is recorded, not silently dropped, but it is still open. Merging now ships the mode switch, mpv inside the real composition, and the newly wired ScreenBrightness without ever running them on the target hardware. RedgifsResolver would also keep preferring `hd` over `sd` on an unmade decision. Either run the Pi acceptance and record it before the PR, or record in the plan's chunk 05 that it is deferred, with the owner's word and what triggers it. Instance.", "files": ["src/arrt_player/sources/resolvers/redgifs.py", "src/arrt_player/__main__.py", "deploy/README.md"], "fid": "R-2"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "tools/tv_api_check.py ends in an AttributeError traceback on a slideshow-mode Player, though its tests promise a sentence", "recommendation": "`config.load()` now returns `ClientSettings | SlideshowSettings`. `SlideshowSettings` has no `frame`. `tools/tv_api_check.py:_frame` reads `load().frame`, and `main` catches only `ConfigError` and `SetupRequired`. So on a Player with PLAYER_MODE=slideshow the tool raises `AttributeError: 'SlideshowSettings' object has no attribute 'frame'`. Its own tests (`test_the_api_check_says_why_it_cannot_start_rather_than_raising`, `test_the_api_check_says_why_a_player_with_no_server_cannot_be_checked`) say it should state why it cannot start. Learning rule: 'When you delete a constant or add a required parameter, grep `tools/` and `scripts/` for consumers', because the linter, the type checker and the suite say nothing about a file nothing imports. Widening `load()`'s return type is the same shape of change. Instance fix: refuse a `SlideshowSettings` by name in `_frame` (slideshow mode has no television), and add a test beside the existing two. Class, bounded: every tool consumer of `load()` that reads an Arrt-only attribute. `tools/power_probe.py` reads `load().frame` too; its broad except catches the error, but it prints the attribute error rather than the reason. `tools/label_preview.py` reads `.panel`, which both settings types carry.", "files": ["src/arrt_player/config.py", "tools/tv_api_check.py", "tools/power_probe.py"], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "An item's Kind is computed at six places across the source seam and read by none; its docstring says it drives the dwell", "recommendation": "Scope: class, bounded to `sources.Kind` and everything that produces or carries it. It broke because the dwell rule was built on mpv's reported duration (dwell.py docstring: 'A length of zero or none is a still'), which made the planned still/clip field redundant, but the field stayed. `Item.kind` (reddit.py `_MEDIA_EXTENSIONS`, `_gallery_media`, `_reddit_media`, `_reddit_copy`, `_direct`), `Resolver.claims` returning `Kind | None` (callers test only `is not None`), `Resolved.kind`, `fetch.Download.kind`, `cache.Cached.kind` and `cache.KIND_BY_EXTENSION` all compute it. In production nothing reads it except `save_listing`/`_saved_items`, which round-trip it to disk. `Kind`'s docstring, 'a still for the dwell's minimum, a clip by the dwell rule', is false of the code: `Slideshow._show_next` passes only `result.duration` to `dwell_seconds`. Who goes wrong: the wave-2b source the plan already names (yt-dlp video pages) has to compute a Kind that does nothing, and someone chasing a one-frame GIF or a still shown too long will change the Kind and see no effect. Close it in one of two ways. Either drop Kind from the seam: `claims` becomes a bool, and Item, Resolved, Download and Cached lose the field. The saved listing can keep ignoring a `kind` key, so its version need not change. Or make the programme read it and pin that with a test. Grep `Kind\\b` and `\\.kind\\b` under src/arrt_player/sources and programmes to find every member.", "files": ["src/arrt_player/sources/__init__.py", "src/arrt_player/sources/reddit.py", "src/arrt_player/sources/fetch.py", "src/arrt_player/sources/cache.py", "src/arrt_player/sources/resolvers/__init__.py", "src/arrt_player/sources/resolvers/imgur.py", "src/arrt_player/sources/resolvers/redgifs.py", "src/arrt_player/programmes/slideshow.py"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "The cache keeps its own copy of fetch.sniff's format table, and a format added only to sniff crashes the play loop", "recommendation": "Scope: instance. It broke because the extensions `fetch.sniff` can produce (`_MAGIC` plus the ftyp/RIFF branches) and the extensions `cache.KIND_BY_EXTENSION` knows are two hand-kept tables, and no test ties them. They agree today, on 7 extensions. If someone adds a format to `sniff` (HEIC, MOV, an AVIF sequence), `MediaCache._fetch_one` stores `got.path` with the new suffix. Then `MediaCache.get` does `KIND_BY_EXTENSION[path.suffix[1:]]`, raises KeyError inside `Slideshow._next_ready`, and `Slideshow.run` fails. After systemd restarts it, `_scan` ignores the file, the fill downloads it again, and the crash repeats. Fix it by construction: have fetch export the one table (for example `SHOWN_FORMATS: dict[str, Kind]`, or a frozenset of extensions if the Kind finding removes Kind), with `sniff` returning entries from it and the cache importing it. Or keep both tables and add a test parametrised over every format `sniff` can return, asserting the cache can `get` a file with that extension.", "files": ["src/arrt_player/sources/cache.py", "src/arrt_player/sources/fetch.py"], "fid": "R-5"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "store.SECRET_KEYS says which keys the page never shows back, but nothing reads it", "recommendation": "Scope: instance. It broke because the constant was declared as the set ('The keys the page takes and never shows back') while the never-shown property was built field by field: `_token_field`, `_cookie_field`, and the `_PINNED_SHOWN` allowlist in config.py. `grep -rn SECRET_KEYS src tests tools` finds only its definition. Nothing stops `server._shown(state, stored, 'REDDIT_SESSION')` from returning the stored cookie, and no test is keyed on the set. Who goes wrong: a maintainer who adds a third secret to SECRET_KEYS reasonably believes the page now hides it, and nothing does. Learnings: 'When a comment names a symbol as the source of truth for a set, parametrise the test over that symbol'. Make it load-bearing: have `_shown` refuse a key in SECRET_KEYS, and add one test parametrised over SECRET_KEYS that sets each key in the file and in the environment and asserts its value is absent from the rendered page and from the journal (read through `conftest.journal`). Otherwise delete the constant.", "files": ["src/arrt_player/settings_ui/store.py", "src/arrt_player/settings_ui/server.py"], "fid": "R-6"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "README.md still describes a Player as only a client of an Arrt server", "recommendation": "Scope: instance. It broke because this feature added a second mode without touching the repository's front page. README.md says 'A Player is a client of the Arrt server', lists only the Frame, HDMI and the panel as what it drives, and says the settings page sets 'the server, its token and the Player's name'. Who goes wrong: someone arriving at this public repo does not learn that `PLAYER_MODE=slideshow` exists, needs no server, needs mpv and the `render` group, and is chosen on the same page. They will look for a server to configure, or assume a Pi without one is broken. Make the description relational rather than a copy: one sentence saying the Player runs in one of two modes (`PLAYER_MODE`), pointing at `.env.example` \u00a7 The mode and `deploy/README.md` \u00a7 The slideshow. CLAUDE.md's 'Run the Player \u2026 It drives the real television' carries the same one-mode assumption and can take the same pointer.", "files": ["README.md"], "fid": "R-7"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "A full disk or an unwritable media cache is reported as the network being down", "recommendation": "Scope: class. The error taxonomy uses bare OSError to mean 'unreachable', and the download path does local file I/O inside that net. `fetch.UNREACHABLE` is `(aiohttp.ClientError, asyncio.TimeoutError, OSError)`. `fetch._save` opens, writes and renames the partial file inside `Fetcher.download`, so ENOSPC, EACCES, or a media root removed while the Player runs all arrive at `MediaCache._fetch_one` as `UNREACHABLE`. The recorded reason is only the type name (`f\"{candidate.tier}: unreachable: {type(error).__name__}\"`, so 'No space left on device' is dropped). After `UNREACHABLE_RUN` (3) such items the cache logs `slideshow.cache.network_down` ('the network looks down'), and the page says 'Downloads stopped: the network seems down.' An operator whose SD card is full gets sent to debug the network and Reddit, and the 30-minute retry hold-back is skipped as if the network were down. Fix: raise local-write failures in `_save` as their own type, outside `UNREACHABLE` (or catch them before the `UNREACHABLE` arm), give them their own reason and page wording, and keep `str(error)` in the reason for every arm. Pin it with a cache test whose downloader raises `OSError(ENOSPC)` from the write, and assert that `network_down` stays False. The search bound is every `except UNREACHABLE` / `*UNREACHABLE` site whose try body touches the filesystem; today that is only the download path. Learnings: 'When a check can be quiet for more than one reason, give each quiet state its own output'.", "files": ["src/arrt_player/sources/fetch.py", "src/arrt_player/sources/cache.py", "src/arrt_player/settings_ui/server.py"], "fid": "R-8"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "Goals still marked Inferred at the merge boundary: still dwell, video-page deferral, one output", "recommendation": "Scope: instance. Three entries in build-plan-slideshow.md \u00a7 Goals still rest on the builder's reading rather than the owner's answer, and the bundle ships them. (1) 'A still shows for min. *Inferred:* the owner did not answer for stills.' (2) Video pages: the owner said 'yes to video pages'. The plan reads that as wanting them, and then defers them to wave 2b on its own inference ('*Inferred:* video pages ... are wave 2b'), so this merge plays none and counts them as unresolved. (3) Constraints: 'the owner's \"one or more\" is narrowed' to one HDMI output, '*Inferred* from the measured architecture'. None of the three appears in the change record's 'Confirmed by the owner' list or in owner-rulings.md. If any of these readings is wrong, the owner finds out on the wall, after the merge. Put the three to the owner in one question before merging, and record the answers where the plan marks them Inferred.", "files": ["src/arrt_player/dwell.py", "src/arrt_player/sources/reddit.py", "src/arrt_player/config.py"], "fid": "R-9"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "The change record's Consumer note ships a rename no release had, and a rollback condition narrower than what writes layout 2", "recommendation": "Records Pass, 'it ships' / 'misleads into action' bars. Scope: instance. (1) The note says 'The event `slideshow.reddit.<outcome>` is now `slideshow.reddit.not_listed` ... The source, cache and resolver events carry their details as fields, not inside the message'. No release ever emitted the old names: base 3ee81a6 (post-v0.7.0) has no `sources/`, `mpv.py` or slideshow code, so this is branch-internal history presented to consumers as a migration. The same goes for the 'What changed' bullet's 'The source, cache and resolvers wrote their event names into the message text'. Delete both. (2) 'Rolling back to an older revision after saving any setting on this one needs the settings file put back to layout 1 by hand.' But `store.write` always writes `VERSION` (2), and it is called on a password set and a password change too (`server.py` `_wrote` at the setup and change-password handlers), not only on a save. An operator who only set or changed the page's password reads the note as saying no edit is needed, rolls back, and the older Player refuses `.settings.json` at start (ConfigError, exit 2, restarted every 5 s). Make it unconditional, as `deploy/README.md` \u00a7 The slideshow already is.", "files": [".prawduct/changes/slideshow.md"], "fid": "R-10"}], "counts": {"blocking": 0, "warning": 10, "note": 0}, "observations": [{"goal": "Nothing Is Broken", "title": "Resolvers.candidates calls a resolver's `claims` outside the guard that keeps a resolver's failure to its own answer", "recommendation": "In `sources/resolvers/__init__.py`, `resolver.claims(item.link)` runs before the `try ... except RESOLVER_FAILURES`. Both resolvers' `claims` call `urlsplit`, which raises ValueError for a netloc with an unbalanced '[', for example. If a post on an imgur or redgifs domain has Reddit media and also such a link, then `items_of` never calls `claims` and the post is listed. At fill time the ValueError escapes `MediaCache.fill`, and by design that ends the run. The saved listing then replays it after the restart. This is unlikely, because Reddit derives `domain` from the URL. A cheap fix is to move the `claims` call inside the same try.", "oid": "O-1"}, {"goal": "Everything Is Coherent", "title": "The fetch importer allowlist and two docstrings name the slideshow programme as an importer of fetch.py, and it is not one", "recommendation": "programmes/slideshow.py imports `sources.cache`, not `sources.fetch`. slideshow_status.py says so itself: 'The programme reaches the network client through the media cache'. Yet `FETCH_IMPORTERS` in tests/test_plane_isolation.py allows slideshow.py, and the `__main__` docstring says 'This module and the programme are the only places outside `sources/` that import its network client'. Removing slideshow.py from `FETCH_IMPORTERS` tightens the guard to what is needed. Then the docstrings in `__main__`, reddit_settings and slideshow_status could name only `sources/` and the entry point. Cheap, and could ride the next commit.", "files": ["tests/test_plane_isolation.py", "src/arrt_player/__main__.py", "src/arrt_player/sources/reddit_settings.py"], "oid": "O-2"}, {"goal": "The Design Is Sound", "title": "Two JWT `exp` readers with different guards", "recommendation": "`reddit_settings.session_expiry` refuses a bool `exp`, a non-dict payload and an out-of-range date. `redgifs._expiry` decodes the same way without those guards. A boolean `exp: true` would make the redgifs token renew before every lookup. reddit_settings is pure and already importable from resolvers, so one shared helper would keep the hardening in one place.", "files": ["src/arrt_player/sources/resolvers/redgifs.py", "src/arrt_player/sources/reddit_settings.py"], "oid": "O-3"}, {"goal": "The Design Is Sound", "title": "MpvOutput's 'mpv is running' test is written out at four sites", "recommendation": "`check`, `refresh`, `_started` and `_held_failure` each rebuild liveness from `_ipc is None`, `_process is None` and `_process.poll()`, with small differences in order and form. Under the lock no invalid combination is reachable outside `_start`, so this is borderline. A single `_running()` predicate would be the one source of truth.", "files": ["src/arrt_player/mpv.py"], "oid": "O-4"}, {"goal": "The Design Is Sound", "title": "The slideshow's Screen seam is typed in mpv's own result classes", "recommendation": "`programmes/slideshow.Screen` returns `mpv.Loaded | mpv.NotShown`, so the programme imports `mpv`, and through it `client` and `kms`. Any other renderer would have to import mpv to satisfy the seam. If Arrt mode moves onto this renderer (Arrt #424, as the plan intends), move Loaded/NotShown beside the protocol at that point.", "files": ["src/arrt_player/programmes/slideshow.py", "src/arrt_player/mpv.py"], "oid": "O-5"}, {"goal": "The Design Is Sound", "title": "`_follow_the_sun` passes `showing=self._current is not None`, which is always True where it is called", "recommendation": "It is called only after a successful load and inside `_dwell`, which returns before calling it when an item is not shown. The 'never written while nothing is shown' property comes from where the call sits, not from this argument. Passing `showing=True` would say that plainly, and a test that calls it with nothing up could pin it.", "files": ["src/arrt_player/programmes/slideshow.py"], "oid": "O-6"}, {"goal": "The Design Is Sound", "title": "read-cost: MediaCache.fill scans and stats the whole cache directory once per item it downloads", "recommendation": "`used_bytes()` runs `os.scandir` plus a stat per file for each item in the loop, so a fill costs items \u00d7 files. At 100 posts a listing (galleries add more) on an SD card this is small, so it is not a finding. If listings grow, keep a running total updated on download and eviction instead (see templates/data-model.md 'Access Paths').", "files": ["src/arrt_player/sources/cache.py"], "oid": "O-7"}, {"goal": "The Design Is Sound", "title": "`_PINNED_SHOWN` is typed `dict[str, object]` and needs a type-ignore at its one use", "recommendation": "Typing it as `dict[str, Callable[[str], str]]` removes the `# type: ignore[operator]` in `load_ui`. Separately, `dwell_problem` and `_slideshow` each parse the two dwell strings with the same defaults. A helper returning `DwellLimits` or raising would parse them once.", "files": ["src/arrt_player/config.py"], "oid": "O-8"}, {"goal": "Everything Is Coherent", "title": "The architecture artifact differs from the code in a task name and in two import rows (for the Records Pass)", "recommendation": "Oracle drift, recorded here for the sustainability Records Pass and not rated by this role. architecture.md's task table names `slideshow-caption`, but the code creates `name=\"slideshow-label\"` (slideshow.py `_draw_wanted`). Its module map, which says it is 'that walk's output', lists config's in-package imports as `compose`, `heartbeat`, `settings_ui.store`, and config now also imports `dwell` and `sources.reddit_settings`. It lists settings_ui/server's as `config`, `settings_ui.auth`, `settings_ui.store`, and server now also imports `client`, `programmes.slideshow_status`, `sources` and `sources.reddit_settings`.", "files": ["src/arrt_player/programmes/slideshow.py", "src/arrt_player/config.py", "src/arrt_player/settings_ui/server.py"], "oid": "O-9"}, {"goal": "Everything Is Coherent", "title": "The source seam says the programme never knows its listing came from Reddit, and the programme's log lines name Reddit", "recommendation": "sources/__init__.py says the programme 'never knows the listing came from Reddit', but slideshow.py logs 'Reddit gave no listing \u2026' and '\u2026 until Reddit answers', and `Outcome.REFUSED`/`COOKIE_REJECTED` are Reddit's states. The wording does no harm with one source. If a second source arrives, word these after the source rather than after Reddit.", "files": ["src/arrt_player/programmes/slideshow.py", "src/arrt_player/sources/__init__.py"], "oid": "O-10"}, {"goal": "The System Can Be Understood", "title": "mpv's own output is discarded, so a start that fails before the socket opens has no reason", "recommendation": "`MpvOutput._start` runs mpv with `--really-quiet` and `stdout`/`stderr` set to `DEVNULL`, and the failure lines arrive only over IPC after `request_log_messages`. An mpv that exits before opening its socket (a rejected option on a newer mpv, a socket it cannot create) is logged only as 'mpv exited with status N before opening its socket'. The operator then has to reproduce it with tools/mpv_check.py. Sending stderr to a file in `runtime_dir` and quoting its tail in that MpvError would close it. Rare with `--idle`, since the VO starts after the socket, so this stays an observation.", "oid": "O-11"}, {"goal": "The System Can Be Understood", "title": "An unforeseen slideshow error ends the process with a raw traceback and no event line", "recommendation": "By design (`Slideshow.run`'s comment), an unexpected exception from the fill or the listing task ends `run_slideshow`, escapes `main` and takes the settings page down until systemd restarts it 5 s later. In Arrt mode the supervisor logs `*_crashed` and restarts workers in-process. Here the journal gets Python's plain traceback and no JSON line with an `event`, so the `jq 'select(.event == \u2026)'` reading the observability strategy prescribes sees only repeated `slideshow.starting`. A single `log.exception(..., extra={\"event\": \"slideshow.crashed\"})` before the re-raise in `run_slideshow` would fix it. No edit is owed if the plain traceback is judged enough.", "oid": "O-12"}, {"goal": "Decisions Were Deliberate", "title": "scope-trace: MpvOutput's ScreenOutput half is consumed by nothing in this change", "recommendation": "`MpvOutput.show`, `refresh`, `listed`, `connected` and `screen` exist so that Arrt mode can move onto mpv later (Arrt #424). Only test_mpv.py calls them: the slideshow uses `load`/`check`/`close`, and tools/mpv_check.py uses `load`. The plan's chunk 01 deliverable and Architecture record why, so it traces to a requirement. Recorded so the unconsumed surface is a known choice. No edit wanted.", "oid": "O-13"}, {"goal": "The System Can Be Understood", "title": "architecture.md names the caption task `slideshow-caption`; the code names it `slideshow-label`", "recommendation": "Records Pass. In the task-tree table in architecture.md \u00a7 The process and its concurrency, the row `slideshow-caption` is created in `Slideshow._draw_wanted` as `name=\"slideshow-label\"`. Separately, `mpv.py` 'runs `ps` once' only where /proc is absent. Neither clears a bar: nothing reads them, and no edit is wanted unless the file is touched anyway.", "oid": "O-14"}, {"goal": "Decisions Were Deliberate", "title": "Chunk 05's Pi acceptance is recorded as owed, not done, at this merge boundary", "recommendation": "Several things are still open: the plan's chunk 05 acceptance (the whole slideshow on the Pi at 4K with captions, switching modes both ways from the page), the cookie-renewal check, and the redgifs HD versus SD decision for clips taller than 1080 lines that chunk 03 left for 'chunk 05 plays one on the Pi and decides'. hdmi-output-findings.md \u00a7 Not observed records all of them honestly as owed, so no record overclaims. `RedgifsResolver` takes `hd` unconditionally until that decision is made. Whether merging before the Pi acceptance is a dropped Done-when is Goal 2's call, not this pass's.", "oid": "O-15"}, {"goal": "Nothing Is Missing", "title": "record-lint chunk-ref-missing: unchecked", "recommendation": "chunk-ref-missing graded chunk 05 of .prawduct/artifacts/build-plan-slideshow.md: chunk 05 was inferred as the plan's first open chun