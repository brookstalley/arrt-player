# Arrt Player: drives this device's screens and its label surface.
#
# Install to /etc/systemd/system/display.service. See deploy/README.md for the
# cutover, which creates the `tvpi` account this unit runs as — the account does
# NOT exist on a freshly rebuilt card, and this unit will refuse to start without
# it rather than fall back to root.

[Unit]
Description=Arrt Player
Documentation=file:///opt/arrt-player/deploy/README.md

# **The stock start rate limit is disabled deliberately, and this is the
# load-bearing line in the file.** systemd's default is five starts in ten
# seconds; `Restart=always` against a fault that reproduces on every start
# exhausts that in about half a second, leaving the unit permanently `failed`,
# having logged five lines, with nothing still trying. That defeats the success
# criterion requiring an unattended failure to be visible without inspecting the
# wall — it produces a dark television AND a service that gave up. `0` is the
# documented value for no rate limiting, and it belongs in [Unit], not [Service].
# It is only safe because RestartSec= below gives the retry an interval; without
# one, "retry forever" would mean retrying at 100 ms.
StartLimitIntervalSec=0

# No ordering dependency on the server, which runs on another machine. The
# Player renders only from its own cache, and a server it cannot reach is a
# state it is built to run in indefinitely.
After=network-online.target
Wants=network-online.target

[Service]
# **Started once the Player says so, and restarted when it stops making
# progress.** The Player sends READY=1 when its mode is running and WATCHDOG=1
# each time it makes progress (`src/arrt_player/notify.py`): the supervisor
# finished a cycle, the slideshow reached its next step, or, in setup mode, the
# page is still served by a loop that turns. Never for the loop merely being
# alive. A start refused by configuration sends nothing and exits 2, which
# Restart=always answers every RestartSec, as before.
Type=notify
# **`all`, not `main`, because the main process is uv.** `uv run` starts the
# Player's Python as its child and waits for it (measured with uv 0.11: the
# Player's parent process is `uv`; the runbook checks it on the Pi), so with
# `main` systemd would drop every message the Player sends, never see READY=1,
# and fail each start at TimeoutStartSec. Every process in
# this cgroup is the Player's own: uv, its Python, and the slideshow's mpv,
# whose environment is an allowlist without NOTIFY_SOCKET (`mpv.MPV_ENVIRONMENT`).
NotifyAccess=all
# **Above the longest honest gap between two pets, with room for the stalls no
# constant bounds.** In Arrt mode a pet follows each finished supervisor cycle:
# the 30 s client poll (`config.DEFAULT_CLIENT_POLL_SECONDS`), the Frame's
# identity read (5 s, `client.IDENTITY_READ_BUDGET_SECONDS`), the heartbeat and
# the client document (30 s each, the client session's total timeout in
# `pull.ClientPull`), and a pet held back by the rate limit (5 s,
# `notify.PET_MIN_SECONDS`): 100 s. In slideshow mode a pet follows each step:
# the longest wait (5 s, `NOT_SHOWN_PAUSE_S`), then the longest load (mpv
# stopped, 5 s; started, 2 x `START_TIMEOUT_SECONDS`; the file put up, 4 x
# `LOAD_TIMEOUT_SECONDS`: 85 s) and the rate limit: 95 s. Setup mode pets every
# 30 s (`notify.SETUP_PET_SECONDS`). What no constant bounds is given the
# 200 s left: the first pass's integrity read of every composed picture on the
# loop (the operator's check 12 measures it), a retired wall's directory
# removed in the cycle, a Pi reclaiming memory at MemoryHigh. The wall's own
# long waits (a slot's dwell, the pull's one-minute backoff, a master's
# minutes of download, a failing master's ten-minute hold) run on tasks beside
# the supervisor and never delay its cycle. Too short restarts a healthy Player,
# and a restart reconnects to the Frame; tests/test_deploy_unit.py derives the
# floor from the same constants.
WatchdogSec=300
# **The orderly stop, as `systemctl stop` sends it**: the stop event, every
# worker closing what it holds, the art channel closed. systemd sends SIGCONT
# after it, so a Player held by SIGSTOP stops this way too. A Player whose event
# loop is itself stuck never runs the handler that sets the stop event; after
# TimeoutAbortSec it is SIGKILLed, the one way out of a loop that will not
# turn, as TimeoutStopSec's comment below accepts for a wedged panel driver.
WatchdogSignal=SIGTERM
# **The same window as TimeoutStopSec, stated rather than inherited.** Unset,
# systemd falls back to TimeoutStopSec unless the manager's
# DefaultTimeoutAbortSec says otherwise; a watchdog's SIGTERM can land inside a
# television connection exactly as `systemctl stop`'s can.
TimeoutAbortSec=90
# **Room for a start that syncs.** Type=simple had no start deadline; now a
# start is failed if READY=1 has not come by this. A start is seconds, but
# `uv run` installs what the lock names and the venv lacks before the Player
# runs, and killing that install every 90 s (the default) would never let it
# finish. The runbook syncs before it starts, so this is the margin, not the
# plan.
TimeoutStartSec=600
User=tvpi
Group=tvpi

# The e-paper HAT is reached through SPI and GPIO; an HDMI screen through the
# display card (`/dev/dri/card*`, group `video`), and its brightness through the
# connector's DDC/CI bus (`/dev/i2c-*`, group `i2c`; `deploy/modules-load.d`).
# A slideshow's mpv also needs the GPU's render node (`/dev/dri/renderD*`, group
# `render`): measured on the Pi 2026-11-10, it cannot draw without it.
SupplementaryGroups=spi gpio video render i2c

# **Everything the Player writes is tvpi's alone.** The television library
# writes the pairing token with a plain open(), so without this the token file
# takes the default umask and any account on the Pi can read it, and with it
# drive the set's art channel. The cache, the settings file and a venv that
# `uv run` syncs at start are created owner-only too; the runbook already does
# all its work as tvpi.
UMask=0077

WorkingDirectory=/opt/arrt-player

# **The sandbox the operator's procedure allows unchanged.** The checkout, the
# venv and `.env` are tvpi's and `uv run` syncs the venv at start, so the code
# directory stays writable; `ProtectSystem=strict` waits on making them root's.
# Each line names what the Player opens that it leaves alone. None of them
# touches `/dev`: the display card, the render node, SPI, GPIO and the DDC bus
# are reached through the groups above, and nothing here sets `PrivateDevices=`,
# `DevicePolicy=` or `ProtectKernelModules=`.
#
# No exec gains privileges: the Player runs uv, Python and mpv, none of them
# set-uid or carrying file capabilities.
NoNewPrivileges=yes
# A /tmp of its own, emptied at stop. Nothing the Player keeps is there: the
# cache, the settings file, the television's token (by default) and mpv's
# socket and pid are all under CACHE_DIR, and uv's cache is under the
# account's home.
PrivateTmp=yes
# /usr, /boot, /efi and /etc read-only. The Player writes under CACHE_DIR,
# /opt/arrt-player (the venv, bytecode) and /var/lib/tvpi (uv's cache and
# interpreter), none of them there, and reads /sys/class/drm, which this leaves.
ProtectSystem=full
# /home, /root and /run/user empty and unreachable. The account's home is
# /var/lib/tvpi, and the runbook checks that `.env` names no path under these.
ProtectHome=yes
# The sockets the Player and mpv open: AF_INET and AF_INET6 for the server, the
# television, Reddit and the settings page; AF_UNIX for mpv's IPC socket and the
# name service's own sockets (mDNS, for a `.local` address); and AF_NETLINK,
# which glibc's getaddrinfo opens to learn the host's addresses for the
# AI_ADDRCONFIG flag aiohttp's resolver passes.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# (AF_UNIX also carries READY=1 and WATCHDOG=1: NOTIFY_SOCKET is a datagram
# socket under /run/systemd, which nothing above hides.)

# **The restrictions that change no path, device or update step**, each checked
# against what the Player and mpv do: they open the display card, the render
# node, SPI, GPIO, the DDC bus and the decoder (`/dev/video*`) through the
# groups above, write under CACHE_DIR, the checkout and /var/lib/tvpi, run uv,
# Python and mpv (aarch64, none set-uid or carrying file capabilities), and
# open the sockets above. None of the lines below names a path or a device.
#
# personality(2) left as it is: nothing here changes its execution domain.
LockPersonality=yes
# No new namespace of any kind: neither Python, uv nor mpv makes one (mpv runs
# no sandbox of its own). systemd's own, for the lines above, are made before.
RestrictNamespaces=yes
# No set-user-id or set-group-id bit set on a file: the Player's only chmods
# make its settings and the television's token 0600.
RestrictSUIDSGID=yes
# No realtime scheduling: mpv is started with --no-audio, so it has no audio
# thread to raise, and neither the panel's driver nor the Player asks for one.
RestrictRealtime=yes
# The hostname neither set nor seen to change: the settings page reads it once
# for the address it prints, from the namespace's copy taken at start.
ProtectHostname=yes
# /dev/kmsg and /proc/kmsg hidden and syslog(2) refused: the Player's journal
# is its own stdout and stderr, which this leaves.
ProtectKernelLogs=yes
# /sys/fs/cgroup read-only: the memory bounds above are systemd's to apply,
# and the Player reads and writes nothing there.
ProtectControlGroups=yes
# System calls of this machine's own architecture only; the Pi's uv, Python
# and mpv are all aarch64 (Trixie, `deploy/README.md`).
SystemCallArchitectures=native
# No capability can be gained. tvpi holds none and nothing it runs carries
# one, so this takes nothing away; it closes the road for a binary that would.
CapabilityBoundingSet=
#
# **Left out on purpose, each because it would hide a device or a path:**
# ProtectClock= (it implies DeviceAllow=char-rtc, and one DeviceAllow= turns
# the device policy into an allowlist: the display card, the render node, SPI,
# GPIO and the DDC bus would all be refused at the next start),
# PrivateDevices=, DevicePolicy=, DeviceAllow=, ProtectKernelModules= and
# ProtectKernelTunables= (/dev and /sys), MemoryDenyWriteExecute= (mpv's GPU
# drivers and the libraries Python loads can map code they write),
# ProcSubset=pid (the GPIO libraries can read the board from /proc), and
# ProtectSystem=strict, which waits on the checkout being root's (the owner,
# 2026-11-19: "not yet").

# **A bound on memory, so an exhausted Pi loses the Player and not sshd.** As a
# share of the Pi's RAM, so one line fits any Pi: 4.8 GB and 6 GB on the
# reference 8 GB Pi 4. Composing one work takes about 1 GB, and walls on one
# client compose at once, one each, so three walls on that Pi stay under
# MemoryHigh, where the kernel starts reclaiming from the Player and slowing it.
# Past MemoryMax the kernel's OOM killer runs inside this unit alone; systemd
# then stops the rest of it with SIGTERM (OOMPolicy=stop, systemd's default) and
# `Restart=always` brings it back. The kernel enforces neither without its
# memory controller, which the runbook checks for.
MemoryHigh=60%
MemoryMax=75%

# **Un-prefixed on purpose.** systemd treats a missing un-prefixed
# EnvironmentFile= as fatal and refuses to start the unit, naming the path it
# wanted. A `-` prefix would make it optional, which restores exactly the silent
# failure this removes: the process starts, raises at import against missing
# variables, and dies for a reason nobody connects to a file that was never
# placed. One .env at the checkout's root, where the Player's settings also
# look for it.
EnvironmentFile=/opt/arrt-player/.env

# **Absolute, not `/usr/bin/env uv`.** systemd's PATH does not include the
# per-user directory uv installs itself into by default, and this account has no
# login to establish one. It does have a home — `/var/lib/tvpi` — but that holds
# uv's cache and its managed interpreter, not uv itself, which is deliberately
# shared and system-owned so every service on the host runs one copy.
# Naming the binary is also the honest failure: a missing interpreter fails here,
# where the path is written, rather than resolving to whatever a PATH= line
# happened to inherit — which is how the recovered 2024 unit came to carry pyenv
# shims and a stray editor directory it never needed.
#
# **Frozen, and without the dev group.** `--frozen` takes the lockfile as it is
# instead of checking it against `pyproject.toml`, so a start never re-resolves
# over the network: an offline boot with a synced venv starts from its cache.
# `--no-dev` keeps pytest and the linters off the Pi, and the two groups are the
# ones the runbook syncs, so a start finds nothing to install. `uv run` adds what
# is missing and removes nothing (`--exact` would).
ExecStart=/usr/local/bin/uv run --frozen --no-dev --group raster --group epaper python -m arrt_player

Restart=always

# At least five seconds, per the rule above. This is the service whose downtime is
# visible, so it should come back from anything without human action — but a
# fault that reproduces every start must stay legible in `systemctl status` and
# keep writing to the journal rather than going quiet.
RestartSec=5

# **A note against SHORTENING this, not an instruction to set it.** 90 s is
# systemd's default and it clears what this daemon needs. The worst-case pass is
# a television connection attempt — roughly 15 s of blocking construction plus
# the 30 s art-channel ceiling — and a SIGTERM landing inside one is honoured
# when that pass ends, not during it: measured at ~22 s against a sleeping set,
# with ~45 s the worst case. A unit that SIGKILLs this process leaves the set
# holding a half-open art channel until it times out on its own side, and the
# next connection is refused for minutes.
#
# **One case runs past that ceiling and is deliberately left to SIGKILL**: a
# panel driver wedged in an SPI transaction that never returns. Label drawing
# happens on a worker thread, so the daemon itself carries on and gives up
# waiting after its label budget — but Python joins that thread on the way out
# and no code can kill a thread parked in C. The television is closed first, so
# by the time this matters the set is already released and a SIGKILL costs
# nothing. That ordering is why this is a bounded nuisance rather than the
# refused-connection problem above.
TimeoutStopSec=90
KillSignal=SIGTERM

# The journal is the Player's only failure channel. Raspberry Pi OS ships
# Storage=volatile, so it lives in RAM — deploy/journald.conf.d bounds it.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=display

[Install]
WantedBy=multi-user.target
