, "tests/test_settings_ui_style.py"], "files_changed": [".env.example", ".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-settings-ui.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/settings-ui.md", ".prawduct/project-state.yaml", "README.md", "deploy/README.md", "src/arrt_player/__main__.py", "src/arrt_player/client.py", "src/arrt_player/config.py", "src/arrt_player/settings_ui/__init__.py", "src/arrt_player/settings_ui/auth.py", "src/arrt_player/settings_ui/server.py", "src/arrt_player/settings_ui/static/fonts/README.md", "src/arrt_player/settings_ui/static/fonts/instrument-sans/OFL.txt", "src/arrt_player/settings_ui/static/fonts/instrument-sans/latin-ext-normal.woff2", "src/arrt_player/settings_ui/static/fonts/instrument-sans/latin-normal.woff2", "src/arrt_player/settings_ui/static/fonts/newsreader/OFL.txt", "src/arrt_player/settings_ui/static/fonts/newsreader/latin-ext-normal.woff2", "src/arrt_player/settings_ui/static/fonts/newsreader/latin-normal.woff2", "src/arrt_player/settings_ui/static/settings.css", "src/arrt_player/settings_ui/store.py", "tests/test_client.py", "tests/test_config.py", "tests/test_deploy_unit.py", "tests/test_plane_isolation.py", "tests/test_settings_ui.py", "tests/test_settings_ui_style.py"], "files_oracle": [".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-settings-ui.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/settings-ui.md", ".prawduct/project-state.yaml"], "findings": [{"goal": "Nothing Is Missing", "severity": "blocking", "title": "record-lint chunk-ref-missing: chunk 02 declares deliverable `settings_ui/server.py`, which the lint cannot resolve", "recommendation": "Relayed from the manifest's record_lint (plan line 149). The module exists at src/arrt_player/settings_ui/server.py; the deliverable is written as a path relative to the package, so the