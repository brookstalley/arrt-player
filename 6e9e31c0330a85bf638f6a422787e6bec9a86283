{"schema": 1, "kind": "review", "id": "rev-20261126T005955Z-6c8d1aca", "ts": "2026-11-26T01:08:10Z", "actor": {"worktree": ".claude/worktrees/plan-wave-3", "plugin": "3.10.0", "branch": "fix/audit-wave-3", "build": "e9c06c071287"}, "body": {"base_commit": "aeeec7e44fe537d62ede82b125ab3d9cc47e3ab4", "base_tree": "924908c02dbf83dfb71d99ef2f4214a2b45e7722", "head_tree": "740c8f56f28f4044c4f81ea4e076533f13a7f845", "head_commit": "6e9e31c0330a85bf638f6a422787e6bec9a86283", "dispatch_commit": "6e9e31c0330a85bf638f6a422787e6bec9a86283", "mode": "cumulative (bundle review, ready for merge)", "mode_chosen_by": "cumulative|explicit-args", "stage": "boundary", "tier": "standard", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": ["deploy/README.md", "pyproject.toml", "src/arrt_player/__main__.py", "src/arrt_player/client.py", "src/arrt_player/compose.py", "src/arrt_player/displays/file_output.py", "src/arrt_player/displays/frame.py", "src/arrt_player/displays/screen.py", "src/arrt_player/heartbeat.py", "src/arrt_player/label_renderer.py", "src/arrt_player/logs.py", "src/arrt_player/manifest.py", "src/arrt_player/panel/epaper.py", "src/arrt_player/programmes/slideshow.py", "src/arrt_player/pull.py", "src/arrt_player/safe_write.py", "src/arrt_player/settings_ui/server.py", "src/arrt_player/settings_ui/static/settings.css", "src/arrt_player/settings_ui/store.py", "src/arrt_player/sources/reddit.py", "src/arrt_player/sources/resolvers/redgifs.py", "src/arrt_player/state/store.py", "src/arrt_player/tv/__init__.py", "src/arrt_player/tv/client.py", "src/arrt_player/tv/samsung.py", "tests/fake_tv.py", "tests/fixtures/reddit/README.md", "tests/server_double.py", "tests/test_availability.py", "tests/test_bindings.py", "tests/test_client.py", "tests/test_epaper.py", "tests/test_frame_wall.py", "tests/test_label_renderer.py", "tests/test_label_rule.py", "tests/test_logs.py", "tests/test_main.py", "tests/test_manifest.py", "tests/test_notify.py", "tests/test_plane_isolation.py", "tests/test_player_contract.py", "tests/test_power_probe.py", "tests/test_pull.py", "tests/test_repository.py", "tests/test_running_without_hardware.py", "tests/test_safe_writes.py", "tests/test_samsung_client.py", "tests/test_settings_ui.py", "tests/test_settings_ui_style.py", "tests/test_slideshow.py", "tests/test_transport_table.py", "tools/power_probe.py", "uv.lock"], "files_changed": [".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-audit-wave-2.md", ".prawduct/artifacts/build-plan-audit-wave-3.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/observability-strategy.md", ".prawduct/artifacts/operational-spec.md", ".prawduct/artifacts/platform-and-dependency-findings.md", ".prawduct/artifacts/samsung-tv-state-findings.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/audit-wave-2.md", ".prawduct/changes/audit-wave-3.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md", "deploy/README.md", "pyproject.toml", "src/arrt_player/__main__.py", "src/arrt_player/client.py", "src/arrt_player/compose.py", "src/arrt_player/displays/file_output.py", "src/arrt_player/displays/frame.py", "src/arrt_player/displays/screen.py", "src/arrt_player/heartbeat.py", "src/arrt_player/label_renderer.py", "src/arrt_player/logs.py", "src/arrt_player/manifest.py", "src/arrt_player/panel/epaper.py", "src/arrt_player/programmes/slideshow.py", "src/arrt_player/pull.py", "src/arrt_player/safe_write.py", "src/arrt_player/settings_ui/server.py", "src/arrt_player/settings_ui/static/settings.css", "src/arrt_player/settings_ui/store.py", "src/arrt_player/sources/reddit.py", "src/arrt_player/sources/resolvers/redgifs.py", "src/arrt_player/state/store.py", "src/arrt_player/tv/__init__.py", "src/arrt_player/tv/client.py", "src/arrt_player/tv/samsung.py", "tests/fake_tv.py", "tests/fixtures/reddit/README.md", "tests/server_double.py", "tests/test_availability.py", "tests/test_bindings.py", "tests/test_client.py", "tests/test_epaper.py", "tests/test_frame_wall.py", "tests/test_label_renderer.py", "tests/test_label_rule.py", "tests/test_logs.py", "tests/test_main.py", "tests/test_manifest.py", "tests/test_notify.py", "tests/test_plane_isolation.py", "tests/test_player_contract.py", "tests/test_power_probe.py", "tests/test_pull.py", "tests/test_repository.py", "tests/test_running_without_hardware.py", "tests/test_safe_writes.py", "tests/test_samsung_client.py", "tests/test_settings_ui.py", "tests/test_settings_ui_style.py", "tests/test_slideshow.py", "tests/test_transport_table.py", "tools/power_probe.py", "uv.lock"], "files_oracle": [".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-audit-wave-2.md", ".prawduct/artifacts/build-plan-audit-wave-3.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/observability-strategy.md", ".prawduct/artifacts/operational-spec.md", ".prawduct/artifacts/platform-and-dependency-findings.md", ".prawduct/artifacts/samsung-tv-state-findings.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/audit-wave-2.md", ".prawduct/changes/audit-wave-3.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "cross-component-contract: the settings page says 'Report unreadable' after a 400, a state the server never enters on a refusal", "recommendation": "The pinned contract-v1.3.0 says the opposite of what the page assumes. The client_heartbeat 400 rows (not_json, not_a_client_heartbeat) say 'Nothing is recorded'. vocabulary() player_states.report_unreadable means 'The report the server holds for this Player is one it cannot read'. The server (Arrt develop, arrt/src/arrt/programming/clients.py record_heartbeat) refuses an unreadable report before writing it, 'so the listing never shows a report it would call unreadable', and player_state.py derives REPORT_UNREADABLE only from a held file whose problem is set. So after a 400, the server's Players page keeps judging this Player by the last report it took: 'Reporting', then 'Not heard from since <date>' once that report is older than 180 s. Meanwhile the Player's page says 'Report unreadable' and keeps saying it until a report is taken (ClientPull._unreadable_since_taken, _answer_to_a_report, settings_ui/server.py player_state). The two pages disagree, which is exactly what operator check 17 and the contract's 'speaks of the Player as the server's Players page does' are there to catch. The tests carry the same false premise, because they assert against the server double rather than the server's state rule: tests/test_settings_ui.py::test_a_report_refused_as_unreadable_reads_report_unreadable and ::test_report_unreadable_is_said_until_a_report_is_taken_as_the_server_says_it. Three records repeat the premise: deploy/README.md ('\"Report unreadable\", as the server's Players page does for the same Player'), architecture.md's failure-table row ('the settings page says \"Report unreadable\" after a 400 until a report is taken'), and the plan's Chunk 09 entry ('as the server does'). Fix, scope instance: after a refusal, keep the state the last taken report gives (reporting or not_heard_from by its age), and say the refusal in the page's own sentence, as a refused token already is. The Player cannot observe the server's report_unreadable, which arises only from a held file the server cannot read, so either drop that word from what the page can claim or state why it stays. Then rewrite the two tests against the server's rule and fix the three records. Learnings: 'When a bug report, decision or record states a cause or premise, run the cheapest experiment that could refute it' \u2014 reading the server's record_heartbeat refutes this premise.", "files": ["src/arrt_player/pull.py", "src/arrt_player/settings_ui/server.py", "tests/test_settings_ui.py", "deploy/README.md"], "check": "cross-component-contract", "scope": "instance", "closure": "The Player claims a server-side state on evidence the server does not treat as that state.", "members": [{"id": "m1", "site": "src/arrt_player/pull.py:_answer_to_a_report / ClientPull.last_answer (_unreadable_since_taken)"}, {"id": "m2", "site": "src/arrt_player/settings_ui/server.py:player_state"}, {"id": "m3", "site": "tests/test_settings_ui.py::test_a_report_refused_as_unreadable_reads_report_unreadable"}, {"id": "m4", "site": "tests/test_settings_ui.py::test_report_unreadable_is_said_until_a_report_is_taken_as_the_server_says_it"}, {"id": "m5", "site": "deploy/README.md (settings page state words paragraph)"}], "fid": "R-1"}, {"goal": "The Design Is Sound", "severity": "blocking", "title": "A GoingOn spell outlives the connection it is named for, so heard_from can be recorded for a set the spell's uploads never reached", "recommendation": "This is an unmodeled-state problem: the phase claims to mirror the art connection and does not. Scope: instance. The cause is the GoingOn branch of `_the_connection_may_have_gone`. `GoingOn.spell` stands for 'the connection the uploads went on' (GoingOn docstring: 'never found on a set met after it has gone'; store.py: 'the connection being its spell'). `_the_connection_may_have_gone` is the hook for a seam failure that may have dropped the art connection. In GoingOn it deliberately does nothing ('a refused upload is no outage'). Two paths reach it in GoingOn with the connection actually closed. (m1) `_upload` catching `TvUploadFailed`: `SamsungTv._attribute` -> `_available` -> `_call` closes `_art` on failure, then returns None, which becomes TvUploadFailed. (m2) `_report_wall_unchanged` when `reported_art_mode()` returns None: `_call` has closed `_art` and the TvUnavailable was swallowed. The next pass's `prepare` calls `self._tv.connect()`, which silently opens a new connection because `_art is None`, and the phase stays `GoingOn` with the same spell. That new connection may reach another set Y at the address, which is exactly the hazard `_connected()` guards against by calling `_forget_the_set()` after its reconnect. If Y then answers `read_identity`, `_know_the_set` runs `self._store.heard_from(phase.spell, Y)`. Every record of that spell, including the failed upload sent to set X whose id was never learned, may then be found on Y by `uploads_on`: by marker alone when exactly one listed picture carries it. A household picture on Y stamped with that second is then taken as the Player's and removed. That goes beyond the residue the plan states ('on one of the two sets': the set the store last recorded, and the set that says which it is on the connection the upload went on), and it is the guarantee the owner's ruling rests on. The odds are small, but the phase and the connection can disagree, and the disagreement is persisted (`heard_from`). Fix: in GoingOn, end the spell when the connection may have gone, keeping the scratch store (the test pins that a refused upload keeps it) but starting a fresh spell id. `_become` closes the old scratch when `phase is not was`, so either let GoingOn take a new spell without a new phase object or make `_become` compare scratch stores. Alternatively, have the seam expose a connection generation that `_know_the_set` compares before calling `heard_from`. Add a test that follows the remove decision through the caller: upload read-back fails in GoingOn, the next pass reaches another set that says, that set lists a picture with the failed upload's marker, and the picture is still on it after reconciliation.", "files": ["src/arrt_player/displays/frame.py"], "scope": "instance", "closure": "A path inside GoingOn on which the art connection is closed while the phase keeps its spell, so the next pass's connect() opens a new connection under the old spell.", "members": [{"id": "m1", "site": "src/arrt_player/displays/frame.py FrameDisplay._upload (TvUploadFailed -> _the_connection_may_have_gone, no-op in GoingOn)"}, {"id": "m2", "site": "src/arrt_player/displays/frame.py FrameDisplay._report_wall_unchanged (reported_art_mode None -> _the_connection_may_have_gone, no-op in GoingOn)"}], "fid": "R-2"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "frame.py prose still describes the superseded rule for uploads of no set and the old sweep", "recommendation": "Scope: class. Prose in frame.py that was written for the pre-ruling sweep or for the 'as first built' matching survived the 2026-11-25 narrowing. (m1) `_forget_the_set` says those uploads are 'removed from the first set whose listing shows them with their markers'. That is exactly the matching integration found unsafe and replaced with two sets only (`_MAY_BE_ON`), and it contradicts the module docstring and `GoingOn`. A maintainer who reconciles the code to this docstring widens the match back to any set, which removes household pictures. (m2) the `_left_on_the_wall` attribute comment says 'Images the set lists that nothing accounts for'. They are now only pictures the upload records name (`ours`) that no binding wants. (m3) `_reconcile_with_the_set` says it runs only on adoption and the hourly retirement look. It is now also owed on leaving GoingOn and while uploads of no set may be on the set (`_know_the_set`). For each, delete the claim or make it relational: point at `DisplayState.uploads_on` / `_MAY_BE_ON` rather than restating the rule. Grep frame.py and state/store.py for 'first set', 'nothing accounts for' and 'cannot account' to bound the class.", "files": ["src/arrt_player/displays/frame.py"], "scope": "class", "closure": "A comment or docstring in the Frame wall or its store that states what is removed, or when reconciliation runs, by the rule before the 2026-11-25 narrowing.", "members": [{"id": "m1", "site": "src/arrt_player/displays/frame.py FrameDisplay._forget_the_set docstring"}, {"id": "m2", "site": "src/arrt_player/displays/frame.py FrameDisplay.__init__ _left_on_the_wall comment"}, {"id": "m3", "site": "src/arrt_player/displays/frame.py FrameDisplay._reconcile_with_the_set docstring"}], "fid": "R-3"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "A set that does not echo the upload marker switches off every removal, and the journal never says so", "recommendation": "Scope: class. It broke because uploads_on discards the one signal that the marker is not echoed: it has that signal at the point where it decides. In DisplayState._match_by_id, a record holding a marker whose id the set lists with no image_date is kept but names nothing (m1). One whose id the set lists with a different date is dropped (m2). Both happen silently. The marker-only path behaves the same way (m3): a record whose id was never learned, with no listed picture carrying its marker, leaves silently. On a set that drops or rewrites image_date, every later re-rendered image and every retired work's image therefore stays on the set for good. That includes a set that echoed the date at operator item 14's one-time pre-deploy check and then took a firmware update. A tv_upload row stays for each picture in case m1. The only sign is tv.others_left_alone, which _say_what_is_left_alone emits once per set per process (_left_alone_said), and its left_alone count mixes the household's pictures with the Player's own unmatched ones. The plan's item 14 calls that sign 'keeps counting', but within one process it never counts again, so an operator sees nothing until the set's storage fills and uploads start failing. Fix: in uploads_on, count the records of the set's own whose id is listed with no date or with another date, and say that count once per set per process. It can go in a field of tv.others_left_alone (for example recorded_unmatched) or in its own event in the inventory. Then a non-echoing set shows up in the journal on the first reconciliation. Also correct item 14's 'keeps counting' sign to the field. The plan's 'As built' note records the silence but not why no line was built. It was added after the owner accepted the costs on 2026-11-25 (0f008dc follows 3f2bdf0).", "files": ["src/arrt_player/state/store.py", "src/arrt_player/displays/frame.py"], "scope": "class", "closure": "A branch of DisplayState.uploads_on where a record that named a picture this Player sent to the listed set stops naming it while the set may still hold that picture, and no journal line says so.", "members": [{"id": "m1", "site": "src/arrt_player/state/store.py:DisplayState._match_by_id (id listed, date None: kept, names nothing)"}, {"id": "m2", "site": "src/arrt_player/state/store.py:DisplayState._match_by_id (id listed with another date: _not_on_it drops the record)"}, {"id": "m3", "site": "src/arrt_player/state/store.py:DisplayState._match_by_marker (no listed picture carries the marker: _not_on_it drops the record)"}], "fid": "R-4"}, {"goal": "Records Pass", "severity": "warning", "title": "Operator item 21 suggests unplugging a screen to make a KMS output refuse a picture, which the code never reports as a refusal", "recommendation": "Scope: instance. The plan's \u00a7 Operator's checklist item 21 says the likeliest way to make a real HDMI output refuse a draw is 'a screen unplugged as a picture is put up', and tells the operator to look for screen.draw_failed, then screen.draw_recovered. KmsOutput.show (src/arrt_player/kms.py) never raises for an unplugged screen. _draw checks the connector report first and calls _gone. A disconnect in the race before present raises ScreenAbsent, which _draw catches and also sends to _gone. So the journal shows screen.absent and screen.returned, and ScreenDisplay._put_up logs rotation.selected as a success. An operator who follows the item will never see the refusal path, and may record it as passed or as not reproducible. Neither is a fact the experiment can produce. What actually reaches ScreenDisplay's retry on KMS is an OSError or ValueError from the card: drmModeSetCrtc or drmModeAddFB refused (for example while another process such as mpv or a console holds DRM master), 'no free CRTC', or a render that fails to decode in fitted. Rewrite item 21 to name a cause the code can raise. Also say that an unplugged screen shows up as screen.absent, which is a different path.", "files": [".prawduct/artifacts/build-plan-audit-wave-3.md"], "scope": "instance", "fid": "R-5"}], "counts": {"blocking": 1, "warning": 4, "note": 0}, "observations": [{"goal": "Nothing Is Unintended", "title": "_forget_the_set's docstring still describes the first-built rule the follow-up closed", "recommendation": "The docstring of src/arrt_player/displays/frame.py FrameDisplay._forget_the_set says uploads recorded with no set are 'removed from the first set whose listing shows them with their markers'. That is the 'as first built' behaviour the 2026-11-25 follow-up removed. The code (store.py _MAY_BE_ON) now finds such a record only on sent_toward or heard_from, listed at its address. A maintainer reading this docstring would take the closed hazard as the design. Delete the clause, or point it at DisplayState.uploads_on. This is a Goal 4 wording item for the design reviewer; recorded here because it sits on the removal path this review was asked to trace.", "files": ["src/arrt_player/displays/frame.py"], "oid": "O-1"}, {"goal": "Nothing Is Missing", "title": "The earlier-head schema-5 store's failure mode is recorded as fact, though nothing measured or pins it", "recommendation": "Reading the code bears the claim out. _widen returns early at version 5. has_unplaced_uploads in _know_the_set runs before the phase becomes Identified, so the pass fails with OperationalError 'no such column: address' (SQLITE_ERROR, not a StoreFault). The wall crashes and the supervisor restarts it with backoff capped at RESTART_MAX_SECONDS 300, and no removal is reachable first. But data-model.md and the plan state this as fact, with no test and no 'read, not run' label. No release wrote that shape, so no edit is required; label it as inference if it is touched again.", "files": ["src/arrt_player/state/store.py"], "oid": "O-2"}, {"goal": "The Design Is Sound", "title": "Retrying a refused screen picture is owned by both the display and the output", "recommendation": "Two layers own retrying a refused draw. `ScreenDisplay._refused` calls `output.show` again each pass and skips `output.refresh`. `FileScreenOutput._owed` and `KmsOutput.refresh` (`_drawn != (_render, screen)`) each redraw on their own. For KMS the cost is unchanged from before: a refusing device was already redrawn every poll through `refresh`. The display retry exists only so the display learns that a draw landed. An output that reported whether its last show landed would let one owner hold the retry. No change wanted now. Worth folding in the next time the ScreenOutput protocol is touched.", "files": ["src/arrt_player/displays/screen.py", "src/arrt_player/displays/file_output.py"], "oid": "O-3"}, {"goal": "The Design Is Sound", "title": "Two identical one-line wrappers over write_whole", "recommendation": "`pull._write_atomically` and `file_output.write_atomically` are the same call with the same `.<name>.tmp` temp name. One helper would do, but each keeps its module's call sites short and the name is the caller's by design. No edit wanted.", "files": ["src/arrt_player/pull.py", "src/arrt_player/displays/file_output.py"], "oid": "O-4"}, {"goal": "The Design Is Sound", "title": "read-cost: record_sending reads every live marker on each upload", "recommendation": "`DisplayState.record_sending` runs `SELECT marker FROM tv_upload WHERE marker IS NOT NULL` on every upload, so its cost follows the size of the table, not the one marker it checks. The table is bounded by what may still be on the sets (a theme's worth, hundreds), so the cost is small. A `SELECT 1 ... WHERE marker = ?` per step of the loop would make it constant. No volume is stated (templates/data-model.md 'Access Paths').", "files": ["src/arrt_player/state/store.py"], "check": "read-cost", "oid": "O-5"}, {"goal": "The Design Is Sound", "title": "Schema 5 widened in place: an earlier-head store fails with an uncaught SQLite error, not a StoreFault", "recommendation": "Not adding a migration is consistent with 'no shims without a deployment'. Note that `no such column` is SQLITE_ERROR, which is not in `_FAULTS`, so `_operation` re-raises it unchanged and the Frame wall crashes and is restarted rather than taking the store-fault path. That is the supervisor's backoff, which matches what the records say ('backing off to five minutes'). The cure the records give, deleting the store, also drops every upload record, so those copies stay on the set. If any such store turns up, an idempotent column-add in `_widen` (the pattern `tv_binding` already uses) would keep the records. No edit wanted while no deploy ran that head.", "files": ["src/arrt_player/state/store.py"], "oid": "O-6"}, {"goal": "The System Can Be Understood", "title": "_forget_the_set's docstring still states the first-built rule for uploads of no set", "recommendation": "src/arrt_player/displays/frame.py FrameDisplay._forget_the_set says uploads of a spell are 'removed from the first set whose listing shows them with their markers'. That is the rule the 2026-11-25 Chunk 04 follow-up replaced. Such a record is now found only on the set it was sent toward or the one heard from on its connection, listed at its address (_MAY_BE_ON). The module docstring, GoingOn's docstring and the store all state the narrowed rule. This one sentence contradicts them, on the household-picture safety property that focus area (a) asks about. Delete the clause, or make it point to GoingOn/uploads_on.", "oid": "O-7"}, {"goal": "The System Can Be Understood", "title": "rule-unenforced: a retired symbol stays cited in a rewritten record row ('When you retire, amend, descope or close anything, first grep the whole repo')", "recommendation": "architecture.md's failure-table row 'The set will not say which set it is' was rewritten by this change, and it still cites FrameDisplay._go_on_unidentified. That symbol no longer exists: Chunk 02 moved the behaviour into _become. observability-strategy.md was corrected to `FrameDisplay._become (entering GoingOn)`. No check owns the artifacts' file:symbol citations: tests/test_artifact_citations.py resolves only `<name>.md \u00a7 <section>`. This wave itself corrected several such citations by hand (_known_as, _scratch, _set_would_not_say), so the class recurs. Mechanising it would take a test that resolves each backticked file:symbol or Class.method citation in .prawduct/artifacts/*.md against src/. This instance alone changes nothing anyone does.", "check": "rule-unenforced", "oid": "O-8"}, {"goal": "Records Pass", "title": "'Measured at integration' for the rollback does not say what was run", "recommendation": "deploy/README.md, the runbook's \u00a7 Going back and step 19b, architecture.md and owner-rulings.md all say the v0.8.0 rollback was measured at integration (it refuses the schema-5 store, parks only the Frame wall and touches nothing on the set). None of them names what ran, on what machine, or against which set or double. The change record says none of it ran on a Pi, and the runbook header lists all of \u00a7 Going back as unrun on a Pi, so the records are consistent. Reading v0.8.0's run_frame_wall supports the claim: it returns on StateSchemaTooNew before frame_wall is built, so nothing connects to the set. Learnings: 'When you record something as verified, name what was measured (fields, cases, N)'. One clause naming the setup would keep a reader of the README from taking it as a run against a television.", "oid": "O-9"}, {"goal": "Decisions Were Deliberate", "title": "The plan still promises final reviews of Chunks 02 and 04 that never ran", "recommendation": "The plan's \u00a7 Governance checkpoints still say Chunks 02 and 04 each get a final review before the next phase is dispatched. Neither review ran, and the plan does not record that this cumulative review stands in for them. The defect that review was meant to catch did occur: integration, not a review, found that a record of no set could match a household picture on any set (the 2026-11-25 Chunk 04 follow-up). Record the deviation and its reason beside the checkpoint.", "oid": "O-10"}, {"goal": "Decisions Were Deliberate", "title": "Chunk 09's real-Player pair test has no recorded outcome", "recommendation": "Chunk 09 lists 'Arrt's player_e2e against this branch's head' among its interactions, and \u00a7 Requests Q3 moves the pin after merge. The plan's Chunk 09 entry under \u00a7 Decisions made mid-build records three tests and the page's state word, but not whether player_e2e ran or was deferred to Q3. The file output's write order changed in this wave, and \u00a7 Left for the next plan already names a server-side flake that ordering can cause. Say which of the two happened.", "oid": "O-11"}, {"goal": "Records Pass", "title": "security-model's rule for 'the Player's picture' leaves out carried records matched by id alone", "recommendation": "security-model.md \u00a7 What it does to the television defines a picture as the Player's by its id together with the marker, or by the marker alone, and names a same-second household picture as the residue. Records carried from a pre-schema-5 store have no marker and match by id alone (_match_by_id, with marker None). data-model.md and runbook step 6a state this for a store whose address moved, but the security model's statement of the rule omits it. One clause would make the stated residue complete.", "oid": "O-12"}, {"goal": "Records Pass", "title": "Records Pass coverage", "recommendation": "Rated all 14 files_oracle records against the three bars: