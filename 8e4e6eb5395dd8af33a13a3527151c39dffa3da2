{"schema": 1, "kind": "review", "id": "rev-20261120T002012Z-647a4891", "ts": "2026-11-20T00:29:28Z", "actor": {"worktree": ".claude/worktrees/w2-integration", "plugin": "3.8.2-dev.1", "branch": "fix/audit-wave-2", "build": "3682719168c6"}, "body": {"base_commit": "f0138b09152b436fb650d6c4b3c2b183c9ab888e", "base_tree": "ed89e123602aa521e8dc469bc5282e013286edf2", "head_tree": "38a31be61eaec5fa0f501c90ac20c33570410f3e", "head_commit": "8e4e6eb5395dd8af33a13a3527151c39dffa3da2", "dispatch_commit": "8e4e6eb5395dd8af33a13a3527151c39dffa3da2", "mode": "cumulative (bundle review, ready for merge)", "mode_chosen_by": "explicit-args", "stage": "boundary", "tier": "standard", "roster": [{"role": "correctness", "model": "claude-opus-5-5"}, {"role": "design", "model": "claude-opus-5-5"}, {"role": "sustainability", "model": "claude-opus-5-5"}], "files_reviewed": [".env.example", ".github/dependabot.yml", "deploy/README.md", "deploy/display.service", "src/arrt_player/__main__.py", "src/arrt_player/client.py", "src/arrt_player/config.py", "src/arrt_player/displays/file_output.py", "src/arrt_player/displays/frame.py", "src/arrt_player/label_renderer.py", "src/arrt_player/logs.py", "src/arrt_player/manifest.py", "src/arrt_player/notify.py", "src/arrt_player/panel/file_surface.py", "src/arrt_player/pull.py", "src/arrt_player/settings_ui/server.py", "src/arrt_player/settings_ui/store.py", "src/arrt_player/state/store.py", "src/arrt_player/wall.py", "tests/test_availability.py", "tests/test_bindings.py", "tests/test_ci_scope.py", "tests/test_client.py", "tests/test_config.py", "tests/test_deploy_unit.py", "tests/test_frame_wall.py", "tests/test_label_outputs.py", "tests/test_label_renderer.py", "tests/test_logs.py", "tests/test_main.py", "tests/test_manifest.py", "tests/test_notify.py", "tests/test_pull.py", "tests/test_repository.py", "tests/test_running_without_hardware.py", "tests/test_settings_ui.py", "tests/test_slideshow.py", "tests/test_tools.py", "tests/workflow_scan.py", "tools/label_preview.py", "tools/power_probe.py", "tools/tv_api_check.py"], "files_changed": [".env.example", ".github/dependabot.yml", ".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-audit-wave-2.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/hdmi-output-findings.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/observability-strategy.md", ".prawduct/artifacts/operational-spec.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/artifacts/samsung-tv-state-findings.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/audit-wave-1.md", ".prawduct/changes/audit-wave-2.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md", "deploy/README.md", "deploy/display.service", "src/arrt_player/__main__.py", "src/arrt_player/client.py", "src/arrt_player/config.py", "src/arrt_player/displays/file_output.py", "src/arrt_player/displays/frame.py", "src/arrt_player/label_renderer.py", "src/arrt_player/logs.py", "src/arrt_player/manifest.py", "src/arrt_player/notify.py", "src/arrt_player/panel/file_surface.py", "src/arrt_player/pull.py", "src/arrt_player/settings_ui/server.py", "src/arrt_player/settings_ui/store.py", "src/arrt_player/state/store.py", "src/arrt_player/wall.py", "tests/test_availability.py", "tests/test_bindings.py", "tests/test_ci_scope.py", "tests/test_client.py", "tests/test_config.py", "tests/test_deploy_unit.py", "tests/test_frame_wall.py", "tests/test_label_outputs.py", "tests/test_label_renderer.py", "tests/test_logs.py", "tests/test_main.py", "tests/test_manifest.py", "tests/test_notify.py", "tests/test_pull.py", "tests/test_repository.py", "tests/test_running_without_hardware.py", "tests/test_settings_ui.py", "tests/test_slideshow.py", "tests/test_tools.py", "tests/workflow_scan.py", "tools/label_preview.py", "tools/power_probe.py", "tools/tv_api_check.py"], "files_oracle": [".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-audit-wave-2.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/hdmi-output-findings.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/observability-strategy.md", ".prawduct/artifacts/operational-spec.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/artifacts/samsung-tv-state-findings.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/audit-wave-1.md", ".prawduct/changes/audit-wave-2.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "No recorded suite run for the bundle under review", "recommendation": "`prawduct-hook test-status` exits 1 with `stale: no .test-evidence.json on disk`, so nothing in this review shows that the whole suite passed at 8e4e6eb. The plan says the coordinator runs the whole suite after Chunk 12 (\u00a7 Verification strategy, \u00a7 Governance checkpoints), but no run was recorded. Run it on the integrated head and record it (`prawduct-hook test-evidence record`, or `--from-junit` from the testament run) before the PR, so a failure inside the 41 changed files cannot reach `develop` unseen. Instance: the evidence was never written for this head.", "fid": "R-1"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "While the set will not say which it is, the wall's uploads pile up on it: the owed reconciliation is marked settled, and each outage starts the theme again", "recommendation": "Two mechanisms combine in `displays/frame.py`. (a) `_remove_orphans` returns True when `_may_remove()` is False, which reads as 'settled'. So the reconciliation a feed owed is cleared while the wall runs on `_scratch`, and when the set later says who it is (SAME or ADOPTED), `_know_the_set`/`_met` do not re-arm it. Whatever the in-memory store uploaded (copies of works the device store already holds) stays in the set's only upload category until the next feed is adopted. The pinned scenario `tests/test_frame_wall.py` \"a set that will not say which it is\" shows this: its last pass uploads w1 and w2 again from the device store, and there is no `list` or `remove` anywhere after the set says. (b) `went_away` -> `_forget_the_set` throws the in-memory store away on every outage. `_unidentified_since` outlives the outage, so the next failed identity read goes straight to a new empty in-memory store, which uploads the theme again, and none of it is ever removed. For a set that opens its art channel and never gives `device.duid` (`samsung-tv-state-findings.md` 'Unmeasured' item 3), every outage adds a theme's worth of images to the set. That is the build-up #18 / Chunk 06 exists to end, here in the fallback mode. This is a class: one quiet answer stands for two different states. Learnings rule \"When a check can be quiet for more than one reason, give each quiet state its own output\": `_remove_orphans` should tell 'nothing to remove' apart from 'may not remove here', and leave the work owed in the second case (return False, or set `_reconciliation_owed` when `_know_the_set` leaves `_scratch`). Add a test that the in-memory store's uploads are removed once the set says. Then either bound what the fallback uploads across outages (keep the in-memory store across an outage until a different identity is read, or stop re-entering the fallback without a fresh patience window) or record the build-up as an accepted cost where `architecture.md` describes the mode. Pin whichever you choose with a scenario where the set never says, across two outages, that asserts how many images the set lists.", "files": ["src/arrt_player/displays/frame.py", "tests/test_frame_wall.py", "tests/test_bindings.py"], "fid": "R-2"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "Reconciliation is marked settled while the wall runs from the in-memory store, and identifying the set again does not owe it, so what was uploaded meanwhile stays on the set until the next feed", "recommendation": "Scope: instance, in displays/frame.py. While the wall runs from the in-memory store, `_remove_orphans` returns True from its `not self._may_remove()` early exit. `prepare` reads that as settled and sets `_reconciliation_owed = False`, even though nothing was removed. That breaks the class's own rule that reconciliation is 'owed until it is done' (the `_reconciliation_owed` comment). When the set later says who it is, `_know_the_set` -> `_met` owes reconciliation only on `SetChange.CHANGED`. On `SAME`, the usual case once a stalled REST port answers, nothing is owed. So everything uploaded to the set from the in-memory store, plus the orphans the feed adopted before the in-memory period would have removed, stays in the set's one upload category until the next `adopted()` or an hourly retirement check. Each outage during the period starts a fresh empty in-memory store (`_forget_the_set` drops the old one) and re-uploads the theme again. This is the storage growth the retirement work (#18) exists to stop. The scope is wider than the records say: `after()` -> `_upload_one_pending` fills the whole theme one picture per pass from the in-memory store, not just what the wall shows. The `tv.unidentified_going_on` line in `_go_on_unidentified` and architecture.md's 'The set will not say which set it is' row both say 'uploading what it shows'. Fix: (a) return False from the `_may_remove()` exit so the work stays owed on `_reconcile_wait`, or set `_reconciliation_owed = True` in `_know_the_set` whenever an identity is read after an unidentified episode (`_unidentified_since` was set, or the in-memory store was in use); and (b) make the log line say the theme is uploaded. Pin it with a test: a set withholds its identity past IDENTITY_PATIENCE_SECONDS, the wall uploads from the in-memory store, the set then says the same identity, and in that pass, with no new feed, the in-memory uploads are removed.", "files": ["src/arrt_player/displays/frame.py"], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "The Frame's which-set-is-this state has no single model: eight fields moved from nine call sites, with reachable combinations nothing intends", "recommendation": "Scope: class, in FrameDisplay. Several call sites have to agree which phase the wall is in: set unknown, identified, withholding its identity, or carrying on unidentified from the in-memory store. That phase is rebuilt from `_on`, `_scratch` and the `_state`/`_store` pair, `_unidentified_since`, `_identity_retry`, `_unidentified_reason`, the `_unidentified` and `_going_on_unidentified` episodes, and `_ended_unidentified` (beside `_ended_on_the_store`). Transitions are spread across `_know_the_set`, `_go_on_unidentified`, `_forget_the_set`, `_the_connection_may_have_gone`, `_leave_the_scratch_store`, `_connected`, `went_away`, `answering` and `close`. Combinations seen in the code: (1) After an outage during the in-memory period, `_forget_the_set` drops the store but leaves `_unidentified_since` and the open `_going_on_unidentified` episode. On the next connection, if the identity retry is not due, the wall raises SetUnidentified even though its patience already ran out. Once the retry is due, it goes straight to a new empty in-memory store with no `tv.unidentified_going_on` line, because that episode never ended. (2) The feed-time counters are taken against whichever store `_state` points at, and are not swapped with it. `adopted()` records `_left_at` on the in-memory store's count, which starts at 0, and `_save_feed_time` later writes those leavings to the device store. `_feed_time_saved_at` is taken from one store and compared with the other's `feed_seconds`. An hourly save on the in-memory store also clears `_left_at`, which held device-store leavings. (3) `belongs_to` commits CHANGED, then `self._store.forget_the_wall()` runs (only when the in-memory store was in use). If that raises StoreFault, `_met` never runs, the next pass's `belongs_to` answers SAME, and the `binding.set_changed` line and the reconciliation it owes are lost. Each is small on its own. Together they mean every change to the identity path also has to know about the retirement counters and the episodes. Model the phase as one value that owns the store in use and its per-store counters (for example an enum or tagged object: Unknown, Identified(identity), Withheld(since), GoingOn(store, since)), moved by one transition method. That method ends the episodes and owes reconciliation as part of the move. Then test each transition from each phase, the outage-during-in-memory-store case included.", "files": ["src/arrt_player/displays/frame.py"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "Atomic file writing is copied again: file_output.write_atomically repeats pull._write_atomically, and WallCaches writes its stamp a third way", "recommendation": "Scope: class. Search src for `.tmp` and `.replace(path)`. There are six hand-written temp-and-rename writers: pull._write_atomically, settings_ui/store.py, heartbeat.py, programmes/slideshow.py, and the two this diff adds. `displays/file_output.write_atomically` is a near-verbatim copy of `pull._write_atomically`, and its docstring says 'as the pull writes its cache'. `client.WallCaches._write_stamp` has already drifted from both: it does not fsync and leaves its temp file behind if the write fails. So which guarantees a given write has depends on which copy its author remembered, and a durability fix (for example fsyncing the directory after the rename) reaches only the copy someone edits. Fix it by construction: one helper in a small shared module, which every one of these calls. Hold it with one test over its failure cleanup and the fsync, rather than adding copies.", "files": ["src/arrt_player/displays/file_output.py", "src/arrt_player/client.py", "src/arrt_player/pull.py"], "fid": "R-5"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "scope-trace: the per-set binding identity (schema 4) and the other mid-build decisions have no vetoable entry in the plan", "recommendation": "Scope: class. It broke because the plan's 'Decisions made mid-build' section, which the coordinator was supposed to fill from the chunk reports, is still empty. Commit 72a96b3 (credited to Chunk 09) added a whole capability that no chunk description or Goals [DECISION] names. It bumps the Frame store to schema 4 with a new tv_binding_aside table, reads device.duid on every connection, waits IDENTITY_PATIENCE_SECONDS (15 minutes) before showing art from a store held in memory, refuses removals without a recorded identity, and adds a pre-upgrade operator step (runbook 6a: delete the store of any wall whose Frame was ever moved). The reasoning is recorded, in architecture.md decision 14, the state/store.py docstring and security-model.md. What is missing is the vetoable record the owner reviews: the plan's Goals list is where the 14-day and 7-day choices were put up for veto, and this one is just as costly and absent. Other mid-build departures are in the same position. The setup-mode pet was built weaker than the Goals [DECISION] states (it pets while the loop turns, notify.Watchdog.while_running, where the decision says 'the page answered'). ProtectClock, listed in Chunk 08, was left out; only the unit comment says why. Neither is in the plan. To close it, append each one to 'Decisions made mid-build' as [DECISION: \u2026 | why | user can veto/override], and correct the Goals watchdog decision's setup-mode clause. To bound the class, compare every chunk's built report against its plan text, item by item.", "files": ["src/arrt_player/state/store.py", "src/arrt_player/displays/frame.py", "src/arrt_player/notify.py", "deploy/display.service"], "fid": "R-6"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "records-pass: the runbook's 'Last executed' header lets every step added since 2026-11-10 read as run on a Pi", "recommendation": "Bar: misleads into action. Scope: class. It broke because the header lists only the steps that were NOT exercised on 2026-11-10 (7, 10\u201311, the way back), so any step added later reads as exercised. This bundle added 6a, 12a, 13a, 13b, 14b, 14c and 19b, and wave 1 added 7b, 7c, 9a and 14a. None of them has run on a Pi, and only 14c says so ('has not been read on this Pi'). An operator following 13a, 14b or 19b takes their Expected lines as observed output. If systemd's real output differs, they go to step 17 and roll back, when it is the runbook that is wrong. 19b's hand edit of PRAGMA user_version also reads as a proven procedure. Learnings rule: 'When you record something as verified, name what was measured (fields, cases, N)'. Fix it in relational form: have the header name the steps that have actually run on a Pi and say that every other step has not. Do not extend the exclusion list; the next added step would fall outside it again.", "files": [".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md"], "fid": "R-7"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "records-pass: runbook step 14b takes the absence of tv.unavailable as proof that the art channel was closed, which that absence cannot show", "recommendation": "Bar: misleads into action (a probe given a question it cannot answer). Scope: instance. It broke because the check looks for a side effect instead of the thing itself. Step 14b holds the Player under SIGSTOP for about 300 s and then reads 'no tv.unavailable follows the restart' as 'the art channel was closed rather than abandoned'. Over five minutes the set may drop the half-open channel on its own side, so a clean reconnect fits an abandoned channel too. A set that is asleep logs tv.unavailable after the restart however the stop went. The orderly stop can be seen directly: the stop path logs frame.stopped (wall.Wall.run, journal_name 'frame') and client.stopped (Supervisor.run's finally) between systemd's 'Watchdog timeout' line and the next 'Started'. The step's grep ('watchdog|Stopping|Started|client.started') leaves both out. Add frame.stopped and client.stopped to the grep, expect both before the restart, and delete the tv.unavailable inference.", "files": [".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md"], "fid": "R-8"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "records-pass: the wave-2 change fragment ships a builder's note and leaves out shipped changes its own closes: list depends on", "recommendation": "Bar: it ships. Scope: instance. It broke because the coordinator edit that was meant to complete the body never fully landed. The fragment still says 'The plan's last chunk completes this body with what was built', and that sentence goes into the release notes as it stands. The body covers the television and the unit. It does not cover changes that reach operators: the new FILE_OUTPUT_DIR, FILE_OUTPUT_SCREEN and FILE_OUTPUT_LABEL settings, the start refusal (exit 2) of an EPD_DEVICE that names more than one panel, the pull and Frame surviving a cache or store fault (#9 and #19, both in its closes: list), and wall_id on every worker line. deploy/README.md \u00a7 'The television's identity, a watchdog and the page's Frame address' already lists these under 'Smaller changes'. Delete the placeholder sentence, add those items to the body (or point at that README section), and put the EPD_DEVICE refusal in the Consumer note, since it stops a start.", "files": [".prawduct/changes/audit-wave-2.md"], "fid": "R-9"}], "counts": {"blocking": 0, "warning": 9, "note": 0}, "observations": [{"goal": "Nothing Is Broken", "title": "The identity comparison in `_may_remove` cannot be false while `_on` is set", "recommendation": "`_on` is set only in `_know_the_set`, after `belongs_to` has recorded that identity and after the in-memory store has been left, so `self._state.tv_identity == self._on` holds whenever `_on is not None`. The only part that defends anything is `_on is not None`, and a mutation that deletes the comparison survives every test. Learnings rule \"When a mutation survives, find why: unreachable (build the case first), inert or rescued by a sibling guard\": either drop the clause, or keep it as a deliberate second guard and say in its docstring that no current path reaches it. Instance.", "files": ["src/arrt_player/displays/frame.py"], "oid": "O-1"}, {"goal": "Nothing Is Broken", "title": "A selection whose reconnect reaches a different set judges the old set's id against the new set's list", "recommendation": "In `show`, `_rebind_or_reraise(picture, content_id)` calls `_connected()`, which can find a different set (`belongs_to` CHANGED). It then checks whether the old set's `refused` id is in the new set's list. If it is (likely, since ids are small and sequential), it raises TvUnavailable saying the set holds an id it was never asked to select. If it is not, it marks orphaned the new set's restored binding for this work, logs `binding.orphaned` for an id the new set never refused, and uploads a duplicate. No wrong-set id is ever selected, so the household rule holds. The costs are one needless upload or one backoff, and a misleading journal line. When `_connected()` reports a change of set, look up `_content_id_for(picture)` again in the store now in use instead of judging the stale id. Instance.", "files": ["src/arrt_player/displays/frame.py"], "oid": "O-2"}, {"goal": "The Design Is Sound", "title": "The file outputs learn what they draw from ambient context variables, one of them read through a logging filter", "recommendation": "`file_output.bound_work_id` builds a LogRecord and runs `logs.WorkCorrelationFilter().filter` on it to read `logs._WORK_ID`, so `shown.json`'s `work_id` depends on how a log filter is implemented. A public `logs.current_work_id()` accessor would be the direct read. The file label's `wall_id` comes from `_CAPTIONING`, which `__main__.run_label` binds around every renderer. If that binding goes missing, `wall_id` is silently null, while a missing `_DRAWING` raises. The docstrings give the reason (a surface is handed only a layout), so this is a judgement call, not a defect.", "files": ["src/arrt_player/displays/file_output.py", "src/arrt_player/__main__.py"], "oid": "O-3"}, {"goal": "Everything Is Coherent", "title": "rule-unenforced: chunk numbers in shipped test comments and docstrings, which no check refuses", "recommendation": "The review protocol says chunk numbers never belong in a shipped comment, because they renumber. This branch just moved Chunks 10 and 11 to the next plan. This diff adds 'Chunk 03/05/06/08/09' citations, for example in tests/test_main.py, tests/test_notify.py, tests/test_settings_ui.py and tests/test_bindings.py. Earlier ones exist in tools/power_probe.py and other tests. No deterministic check owns the rule. A scan in tests/test_repository.py's one leak scanner, refusing `[Cc]hunk \\d{2}` in src/, tools/ and tests/, would enforce it. This is prose nothing reads, so no edit is owed for these instances.", "files": ["tests/test_main.py", "tests/test_notify.py", "tests/test_settings_ui.py", "tests/test_bindings.py"], "oid": "O-4"}, {"goal": "Everything Is Coherent", "title": "Outside my goals (Goal 4, for the design reviewer): deploy/README's store-finding command probably returns nothing as written", "recommendation": "deploy/README.md \u00a7 'The television's identity, a watchdog and the page's Frame address' gives `ls \"$CACHE_DIR\"/*/display-state.sqlite`. There, $CACHE_DIR is not a shell variable, and the wall directories are created by the Player under UMask=0077, so they are 0700 tvpi. Run as the operator, the glob most likely finds nothing or permission is refused, and the operator concludes there is no store to delete. That is exactly the hazard the paragraph warns about. Runbook step 6a does it correctly (`sudo grep '^CACHE_DIR='` and then `sudo -u tvpi find`). Rated here only so it is not lost: a wrong command in a subject file is Goal 4's to rate, possibly at BLOCKING.", "files": ["deploy/README.md"], "oid": "O-5"}, {"goal": "Everything Is Coherent", "title": "Runbook 19b points to 'step 6a's find', but 6a is conditional", "recommendation": "An operator who skipped 6a (the Frame was always the same set) has no find output to take the store paths from. Give the two commands (`sudo grep '^CACHE_DIR='` and `sudo -u tvpi find \u2026 -name display-state.sqlite`) inside 19b itself.", "files": [".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md"], "oid": "O-6"}, {"goal": "The System Can Be Understood", "title": "A lasting store write fault keeps uploading untracked copies to the set, and is recorded as 'left open' with nothing tracking it", "recommendation": "architecture.md's failure table and operational-spec.md's store.failed row both say that while a write fault lasts, every pass uploads a copy the store cannot record, one per backoff step (up to TV_RETRY_MAX_SECONDS, 300 s by default). That is a growing collection on the set's only upload category, and store.failed at ERROR, said once, is its only signal. It is detected and recorded, so it is not a finding. But I found no backlog item or plan entry that owns the 'left open'. Whoever disposes of this review should decide whether it needs one. The orphan path probably clears the copies once the store records again; that is unverified.", "files": ["src/arrt_player/displays/frame.py"], "oid": "O-7"}, {"goal": "The System Can Be Understood", "title": "Watchdog coverage reviewed: no path found that kills a healthy Player or keeps a stuck supervisor or slideshow petted", "recommendation": "No action. In Arrt mode the pet comes only after Supervisor.cycle completes. Every await in the cycle is bounded: FrameIdentity at 5 s by wait_for, report and fetch by the pull session's 30 s total, and the sweep's rmtree runs on a thread. client_poll_seconds is not an .env key, so the 100 s gap cannot be configured past WatchdogSec=300. Slideshow waits are at most 5 s (NOT_SHOWN_PAUSE_S, CHECK_EVERY_S=1). Setup mode pets every 30 s while the page task runs. That is weaker by design, and README and architecture both say so. What the watchdog does not cover: one wedged wall worker in Arrt mode, a stalled slideshow listing or fill task, and a page handler that hangs while the loop still turns. All three are recorded as deliberate.", "files": ["src/arrt_player/notify.py", "src/arrt_player/__main__.py", "deploy/display.service"], "oid": "O-8"}], "duration_seconds": 1000, "scope": "audit-wave-2", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "12"], "chunks_proposed": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "12"], "base_reviewed": "f0138b09152b436fb650d6c4b3c2b183c9ab888e", "record_lint": {"records": [".prawduct/artifacts/architecture.md", ".prawduct/artifacts/build-plan-audit-wave-2.md", ".prawduct/artifacts/data-model.md", ".prawduct/artifacts/hdmi-output-findings.md", ".prawduct/artifacts/nonfunctional-requirements.md", ".prawduct/artifacts/observability-strategy.md", ".prawduct/artifacts/operational-spec.md", ".prawduct/artifacts/project-preferences.md", ".prawduct/artifacts/samsung-tv-state-findings.md", ".prawduct/artifacts/security-model.md", ".prawduct/changes/audit-wave-1.md", ".prawduct/changes/audit-wave-2.md", ".prawduct/owner-rulings.md", ".prawduct/runbooks/moving-the-pi-player-to-a-new-revision.md", "deploy/README.md"], "chunk_graded": "01", "chunks_graded": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "12"], "plan_graded": ".prawduct/artifacts/build-plan-audit-wave-2.md", "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": 0, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasone